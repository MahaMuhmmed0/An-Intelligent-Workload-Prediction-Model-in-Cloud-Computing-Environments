# Copy to .env (or export these as real environment variables) and point
# them at your own local copies of the two public traces. If unset, the
# code falls back to a repository-relative default: data/google_2019/ and
# data/alibaba_2017/. See README.md "Dataset locations".
#
# Note: these files are not read automatically from a ".env" file -- the
# project has no python-dotenv dependency (kept deliberately minimal). Either
# `export`/`$env:` these yourself before running, or place your data at the
# default repository-relative paths below.

# Full path to the Google 2019 Cluster CSV extract (borg_traces_data.csv).
GOOGLE_2019_CSV=data/google_2019/borg_traces_data.csv

# Directory containing the Alibaba cluster-trace-v2017 CSVs
# (container_event.csv, container_usage.csv, server_usage.csv).
ALIBABA_2017_DIR=data/alibaba_2017
